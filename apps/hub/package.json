{
  "name": "@workmesh/hub",
  "private": true,
  "version": "0.1.0",
  "description": "Workmesh team hub: Cloudflare Worker + Durable Object, and the board it serves",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:board": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.board.json && tsc -p tsconfig.scripts.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types --strict-vars=false --env-file /dev/null",
    "deploy": "npm run build && wrangler deploy",
    "fake-relay": "node scripts/fake-relay.ts"
  },
  "dependencies": {
    "@workmesh/protocol": "*",
    "hono": "^4.13.21",
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@number-flow/react": "0.5.10",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-radio-group": "1.3.7",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vaul": "1.1.2",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "web-haptics": "0.0.6",
    "wouter": "3.13.0",
    "wrangler": "4.166.0"
  }
}
