{
  "name": "@b3os/workmesh",
  "version": "0.7.0",
  "description": "Workmesh: your team's coding agents (Claude Code, Codex) and the people they work for, on one live board. Also syncs your Slack status. Formerly agentblip.",
  "type": "module",
  "license": "MIT",
  "author": "Sean Geng",
  "homepage": "https://agentblip.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b3-fun/agentblip.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/b3-fun/agentblip/issues"
  },
  "bin": {
    "workmesh": "./dist/index.js",
    "agentblip": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agents",
    "ai",
    "ai-agents",
    "automation",
    "claude",
    "claude-code",
    "cli",
    "codex",
    "coding-agents",
    "daemon",
    "developer-tools",
    "hooks",
    "multiplayer",
    "presence",
    "productivity",
    "slack",
    "slack-status",
    "status",
    "team",
    "workmesh"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/index.js', 493)\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chokidar": "^4.0.1",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@agentblip/core": "*",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
