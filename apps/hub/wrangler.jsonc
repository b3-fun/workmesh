{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bullpen",
  // NPC Labs. Never deploy to another account (AGENTS.md).
  "account_id": "4300a93c2dcb252fa91df03f18e8e44c",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-19",
  // The only way in is the Access-protected custom domain.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "bullpen.b3os.org", "custom_domain": true }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/relay/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "PROJECT", "class_name": "Project" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Project"] }],
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "npclabs.cloudflareaccess.com",
    "ACCESS_AUD": "a3f9a834dccc7096ab27aa4f3470df3b5bd14618c40e641e92b751b696b70f63"
  },
  "observability": { "enabled": true }
}
