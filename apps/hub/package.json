{
  "name": "bullpen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "scripts": {
    "dev": "pnpm build && wrangler dev",
    "dev:board": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.board.json && tsc -p tsconfig.scripts.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types --strict-vars=false --env-file /dev/null",
    "deploy": "pnpm build && wrangler deploy",
    "fake-relay": "node scripts/fake-relay.ts"
  },
  "dependencies": {
    "hono": "^4.13.21",
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.166.0"
  }
}
